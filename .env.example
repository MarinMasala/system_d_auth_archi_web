# Development values only. Replace the secret values before using this outside
# your local machine. Keep real .env files out of Git.
SECRET_KEY=replace-with-a-long-random-secret
DB_NAME=authdb
DB_USER=authuser
DB_PASSWORD=change-this-database-password
DB_ROOT_PASSWORD=change-this-root-password

# Optional email sandbox configuration (Mailtrap).
MAIL_USERNAME=
MAIL_PASSWORD=
